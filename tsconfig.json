{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "community-specials": [
        "kit/index.ts"
      ]
    },
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": [
    "kit",
    "scripts",
    "tests",
    "demo/scripts",
    "demo/*.ts",
    "demo/*.tsx"
  ]
}
